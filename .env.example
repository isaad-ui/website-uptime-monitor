# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# How long to wait for a website response before timing out (seconds, 1-60).
# Default: 10
REQUEST_TIMEOUT=10

# Maximum number of history records shown by --history.
# Default: 100
MAX_HISTORY_DISPLAY=100

# Minimum log level: DEBUG, INFO, WARNING, ERROR
# DEBUG shows the most detail. ERROR shows only failures.
# Default: INFO
LOG_LEVEL=INFO

# Path to a log file. Leave empty to log to the terminal only.
# Example: LOG_FILE=logs/uptime.log
LOG_FILE=

# Maximum size of one log file before it rotates (bytes). Default: 1048576 (1 MB)
LOG_MAX_BYTES=1048576

# Number of old log files to keep. Default: 3
LOG_BACKUP_COUNT=3
